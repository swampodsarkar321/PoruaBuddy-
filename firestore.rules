rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mdswampodsarkar007@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check
    match /test/connection {
      allow get: if true;
    }

    // Products collection
    match /products/{productId} {
      allow get, list: if (resource.data.isPublished == true) || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid) || (resource.data.customerEmail == request.auth.token.email);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && (
        request.resource.data.paymentStatus in ['Pending', 'Awaiting Payment', 'Payment Under Review']
      ) && (
        isAdmin() ||
        (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId == 'guest')
      );
      // Customer can only submit transaction details (moving to Payment Under Review). Status change to 'Paid'/'Completed' requires admin.
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transactionId', 'senderPhone', 'paymentMethod', 'paymentStatus', 'updatedAt']) &&
         request.resource.data.paymentStatus == 'Payment Under Review')
      );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && (request.resource.data.role == 'customer' || isAdmin());
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin privileges map
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if request.auth.token.email == 'mdswampodsarkar007@gmail.com';
    }

    // Inquiries collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow get, list, update, delete: if isAdmin();
    }

    // Site settings collection
    match /siteSettings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
